# Google AI Studio / Gemini API. Create the key in AI Studio and never commit the real value.
GEMINI_API_KEY=
GOOGLE_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_TRANSCRIPTION_MODEL=gemini-3.1-flash-lite
GOOGLE_LLM_MODEL=gemini-3.1-flash-lite
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Backward-compatible key name from the previous external API setup.
# EXTERNAL_API_KEY can still be used by docker-compose when GEMINI_API_KEY is empty.
EXTERNAL_API_KEY=

# Service settings
APP_PORT=8001
DEFAULT_LANGUAGE=zh
OUTPUT_LANGUAGE=繁體中文
MAX_UPLOAD_MB=800
PREVIEW_LIMIT=12000
