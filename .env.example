# Google AI Studio report LLM through Gemini's OpenAI-compatible endpoint.
# Create the key in AI Studio and never commit the real value.
MEETING_CHAT_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MEETING_CHAT_API_KEY=
MEETING_CHAT_MODEL=gemini-3.5-flash

# Local Whisper transcription. RTX 4070 Ti defaults to medium/cuda/float16.
WHISPER_MODEL=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Service settings
APP_PORT=8001
DEFAULT_LANGUAGE=zh
OUTPUT_LANGUAGE=繁體中文
MAX_UPLOAD_MB=800
PREVIEW_LIMIT=12000
