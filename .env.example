# OpenAI-compatible external API. Do not commit the real key.
EXTERNAL_API_BASE_URL=https://api.openai.com/v1
EXTERNAL_API_KEY=
EXTERNAL_LLM_MODEL=gpt-4o-mini
EXTERNAL_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
EXTERNAL_TRANSCRIPTION_RESPONSE_FORMAT=verbose_json

# Service settings
APP_PORT=8001
DEFAULT_LANGUAGE=zh
OUTPUT_LANGUAGE=繁體中文
# External providers often impose a smaller media-upload limit; override only when supported.
MAX_UPLOAD_MB=25
PREVIEW_LIMIT=12000
